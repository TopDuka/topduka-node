{
  "name": "@valebytes/topduka-node",
  "version": "1.0.1",
  "description": "TopDuka Node.js SDK for storefront APIs",
  "homepage": "https://github.com/TopDuka/topduka-node#readme",
  "bugs": {
    "url": "https://github.com/TopDuka/topduka-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TopDuka/topduka-node.git"
  },
  "license": "MIT",
  "author": "ValeBytes",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.js"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "axios": "^1.7.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "module": "dist/index.mjs"
}
